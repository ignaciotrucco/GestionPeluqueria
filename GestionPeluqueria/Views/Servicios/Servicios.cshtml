@{
    ViewData["Title"] = "Servicios";
}

<link rel="stylesheet" href="~/css/abm.css" asp-append-version="true" />

<!-- Encabezado ABM -->
<div class="card m-4">
    <div class="card-body">
        <div class="mt-3">
            <div class="row">
                <div class="col-auto me-auto">
                    <h1 class="hover-icon">SERVICIOS
                    </h1>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalServicios" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true"
     id="staticBackdrop" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModal"></h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    @* <div class="d-flex">
                        <p class="campoObligatorio">Los campos marcados con un asterisco (<span
                            class="asterisco">*</span>) son obligatorios</p>
                            <p class="asterisco" style="padding-left:0 !important;padding-right: 0 !important;">*</p>
                            <p class="campoObligatorio">) son obligatorios </p>
                        </div> *@
                    <form>
                        <div class="col-md-10" style="width: auto !important;">
                            <input type="hidden" id="ServicioID">

                            <label for="NombreServicio" class="form-label d-flex mb-1">
                                Nombre<p class="asterisco">*</p>
                            </label>
                            <input type="text" class="form-control mb-3" id="NombreServicio"
                                   style="text-transform:uppercase">
                            <span id="NombreError" class="textoError"></span>

                            <label for="DescripcionServicio" class="form-label d-flex mb-1">
                                Descripción<p class="asterisco">*</p>
                            </label>
                            <input type="text" class="form-control mb-3" id="DescripcionServicio"
                                   style="text-transform:uppercase">
                            <span id="DescripcionError" class="textoError"></span>

                            <label for="PrecioServicio" class="form-label d-flex mb-1">
                                Precio<p class="asterisco">*</p>
                            </label>
                            <input type="number" class="form-control mb-3" id="PrecioServicio" step="0.01" min="0">
                            <span id="PrecioError" class="textoError"></span>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="GuardarRegistros()">Guardar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"
                        onclick="LimpiarModal()">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Boton Modal -->
<div class="btnAgregar">
    <button type="button" class="btn btn-secondary btn-circle btn-lg d-flex" style="padding-bottom: 2px;"
            title="Agregar" data-bs-toggle="modal" data-bs-target="#modalServicios" data-bs-target="#staticBackdrop"
            onclick="NuevoRegistro()">
        <i class="fa-solid fa-plus mt-1"></i>
        <h5 style="margin-left: 3px; padding-top: 1px;" class="textBtnAgregar">Nuevo Servicio</h5>
    </button>
</div>

<!-- Tabla -->
<div class="card m-4">
    @* <div class="card-header">
            <div class="row">
                <div class="col-auto">
                    <div class="input-group m-2">
                        <span class="input-group-text" id="basic-addon1"><i
                            class="fas fa-magnifying-glass-location icon"></i></span>
                            <input type="text" id="inputBusqueda" class="form-control inputBusqueda"
                                   placeholder="Buscar por nombre..." style="text-transform:uppercase">
                        </div>
                    </div>
                </div>
            </div> *@
    <div class="card-body">
        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-striped mt-1" id="imprimir-tabla">
                <thead>
                    <tr>
                        <th scope="col" style="text-align: center">NOMBRE</th>
                        <th scope="col" style="text-align: center">DESCRIPCION</th>
                        <th scope="col" style="text-align: center">PRECIO</th>
                        <th scope="col"></th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody id="tbody-servicios"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/servicios.js"></script>
}